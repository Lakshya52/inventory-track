# Copy this file to .env.local and point it at your running backend.
# The value must include the /api prefix and no trailing slash.

# Web / iOS simulator (backend on the same machine)
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# Android emulator instead use:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api

# Physical phone (same Wi-Fi) instead use your computer's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.25:3001/api

# Production:
# EXPO_PUBLIC_API_URL=https://your-api-host.example.com/api
