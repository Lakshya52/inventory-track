PORT=3001

# Database switch: "mysql" or "mongo". The Render deployment blueprint uses MongoDB.
DB_CLIENT=mongo

# --- MySQL (used when DB_CLIENT=mysql) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=factory_inventory
DB_POOL_SIZE=20

# --- MongoDB (used when DB_CLIENT=mongo) ---
# Replace this example with your MongoDB Atlas connection string before deploying.
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/factory_inventory?retryWrites=true&w=majority
# MONGO_DB_NAME=factory_inventory
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_MAX_POOL_SIZE=20

# Auth
# Use a long, randomly generated secret. Keep the production value in Render,
# not in source control or Vercel. Render can generate this value automatically.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_DAYS=30

# CORS
# Set to the exact deployed Vercel origin; add custom domains comma-separated.
CORS_ORIGIN=https://your-project.vercel.app

# Uploads
# On Render, set this to /var/data/uploads and attach a persistent disk at /var/data.
# Leave unset for local development (uploads are stored in backend/uploads).
# UPLOAD_DIR=/var/data/uploads

# Operational limits
API_RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=20
SYNC_RATE_LIMIT_PER_MINUTE=180
ALLOW_DIRECT_DISPATCH=false
