{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://inventory-track-q551.onrender.com"
      }
    },
    "preview": {
      "extends": "base",
